JWT_SECRET=replace-this-with-a-random-secret
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=

POSTGRES_PASSWORD=replace-this-with-a-local-database-password
GOOSE_DBSTRING=host=localhost user=invoice_app password=replace-with-POSTGRES_PASSWORD dbname=invoice_reconciliation sslmode=disable

GMAIL_CLIENT_ID=replace-with-google-oauth-web-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_TOKEN_FILE=tokens/gmail-token.json
GMAIL_REDIRECT_URL=http://localhost:8081/email/gmail/callback
GMAIL_FRONTEND_URL=http://localhost:5173/
